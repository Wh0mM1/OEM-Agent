# ==============================================================================
# Mahindra Automotive OEM AI Concierge - Unified Environment Configuration
# ==============================================================================

# Application & Networking Settings
APP_ENV=development
PORT=8000
FRONTEND_PORT=3000

# LLM Provider Configuration ('openrouter', 'groq', 'gemini', 'ollama')
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Recommended Free Tier)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq Configuration (Alternative Free Tier)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Local Ollama Configuration (When running Ollama on host machine)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Zoho CRM OAuth 2.0 Credentials (Set USE_MOCK_ZOHO=false for live sync)
USE_MOCK_ZOHO=false
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token

# Zoho Data Center Specific Domains (Options: in, com, eu, com.au)
ZOHO_DC=in
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/crm/v8
