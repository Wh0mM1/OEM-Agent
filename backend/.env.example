# Application Settings
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# LLM Provider: 'openrouter' (default, free models available), 'groq', 'gemini', or 'ollama'
LLM_PROVIDER=openrouter

# Groq Free Tier Settings (Get free key at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter Settings (Get free key at: https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini Settings (Get free API key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Local Ollama Settings (Optional, run: ollama serve && ollama pull llama3.2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Zoho CRM OAuth 2.0 Integration
# Set to 'false' once real Self-Client credentials from developer.zoho.com are configured
USE_MOCK_ZOHO=false

# Zoho Developer Console Self-Client Credentials (https://api-console.zoho.com/)
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token

# Data Center Configuration (CRITICAL: Match the region where your Zoho CRM account was created)
# Options: 'in' (India), 'com' (US), 'eu' (Europe), 'com.au' (Australia)
ZOHO_DC=in
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/crm/v8
